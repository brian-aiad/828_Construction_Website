# Copy this to .env.local and fill in your values

# Resend email API key — get yours at resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Independent signing secret for the contact form's short-lived browser token.
# Generate at least 32 random bytes; production falls back to RESEND_API_KEY
# only while this variable is not yet configured.
CONTACT_FORM_SECRET=replace_with_a_long_random_secret

# Email address where contact form submissions are sent. Change this value to
# route leads to a different inbox without editing application code.
CONTACT_EMAIL=828constructionca@gmail.com

# Sender shown in Joe's inbox. Domain must be verified in Resend for production.
CONTACT_FROM_EMAIL="828 Construction <website@updates.828constructions.com>"

# Optional Google Analytics measurement ID (public, not an API secret).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
