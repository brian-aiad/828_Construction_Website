  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:3001": "next dev -p 3001",
    "dev:keep": "node scripts/dev-watchdog.mjs",
    "prebuild": "node scripts/clean-build-output.mjs",
    "build": "next typegen && tsc --noEmit && next build",
    "postbuild": "node scripts/audit-build-output.mjs && node scripts/audit-public-images.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:contact": "tsx --test tests/contact-security.test.ts",
    "audit:a11y": "node scripts/accessibility-audit.mjs",
    "test:contact:browser": "playwright test tests/contact-form-browser.spec.ts --project=chromium",
    "preflight": "node scripts/preflight.mjs --fast",
    "preflight:full": "node scripts/preflight.mjs",
    "preflight:desktop": "node scripts/preflight.mjs --fast --desktop",
    "preflight:mobile": "node scripts/preflight.mjs --fast --mobile"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.32.0",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "split-type": "^0.3.4",
    "yet-another-react-lightbox": "^3.29.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.11.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
